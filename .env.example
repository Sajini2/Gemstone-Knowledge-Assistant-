# Gemstone Knowledge Assistant - Environment Key Configuration
# Copy this file to .env and add your actual API keys.

# 1. Groq API Key (Primary LLM Provider)
# Get a free key at: https://console.groq.com/keys
GROQ_API_KEY=gsk_your_actual_groq_api_key_here

# 2. OpenRouter API Key (Alternative / Backup LLM Provider)
# Get a key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-your_actual_openrouter_api_key_here
